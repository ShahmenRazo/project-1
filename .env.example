# Supabase (dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — ТОЛЬКО server-side (никогда не в клиентский код)
# Нужен для кросс-пользовательских операций (уведомления, поиск юзеров по email)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LemonSqueezy (dashboard.lemonsqueezy.com -> Settings -> API)
# API key для создания checkout
LEMONSQUEEZY_API_KEY=YOUR_LS_API_KEY
# ID магазина (Settings -> Store)
LEMONSQUEEZY_STORE_ID=YOUR_STORE_ID
# ID варианта плана Pro (Products -> Pro -> Variants)
LEMONSQUEEZY_PRO_VARIANT_ID=YOUR_PRO_VARIANT_ID
# Secret вебхука (Settings -> Webhooks): подпись X-Signature
LEMONSQUEEZY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Абсолютный URL приложения (для redirect после оплаты)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Cloud Messaging (console.firebase.google.com -> Project settings)
# Web-приложение -> Секрет веб-приложения (SDK config)
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=subsplit
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc...
# Cloud Messaging -> Web Push certificates -> Key pair (публичный ключ)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BL2Y9...

# Server-side (для HTTP v1 API):
# Project Settings -> Service accounts -> Generate new private key (JSON)
# Вставьте весь JSON одной строкой (с экранированными \n в private_key)
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"firebase-adminsdk-xxx@subsplit.iam.gserviceaccount.com",...}
# Тот же project_id, что и выше
FIREBASE_PROJECT_ID=subsplit

# Секрет для Vercel Cron (защита /api/cron/*)
CRON_SECRET=openssl rand -hex 32

# Настройка вебхука в LemonSqueezy:
#   URL:  https://YOUR_DOMAIN/api/billing/webhook
#   Подписка: subscription_created, subscription_updated,
#             subscription_cancelled, subscription_resumed,
#             subscription_expired
